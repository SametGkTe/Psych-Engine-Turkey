<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- _________________________ Application Settings _________________________ -->
	<!-- ___ Build with spesific libraries ___ -->
	<architecture exclude="armv7" if="ONLY_ARM64" />
	<architecture exclude="armeabi-v7a" if="ONLY_ARM64" />
	<architecture exclude="arm64" if="ONLY_ARMV7" />
	<architecture exclude="arm64-v8a" if="ONLY_ARMV7" />

	<app unless="mobile" title="Psych Engine Turkiye V2.5 Unleashed" 
		file="PsychEngine" packageName="com.shadowmario.psychengine" 
		package="com.shadowmario.psychengine" main="Main" version="0.2.8" company="ShadowMario" />

	<app if="mobile" title="Psych Engine Turkiye V2.5" 
		file="PsychEngine" packageName="com.sametgkte.psychturkiyev25" 
		package="com.sametgkte.psychturkiyev25" main="Main" version="0.2.8" company="SametGkTe" />

	<meta build-number="28" />
	
	<set name="APP_ID" value="0x0100f6c013bbc000" />

	<haxedef name="LINC_LUA_RELATIVE_DYNAMIC_LIB"/>

	<app preloader="flixel.system.FlxPreloader" />

	<set name="SWF_VERSION" value="11.8" />

	<!-- ______________________ PSYCH ENGINE CUSTOMIZATION ______________________ -->

	<define name="MODS_ALLOWED" if="desktop || mobile" />
	<define name="HSCRIPT_ALLOWED" if="desktop || mobile" />
	<define name="LUA_ALLOWED" if="cpp" />
	<define name="ACHIEVEMENTS_ALLOWED" />
	<define name="DISCORD_ALLOWED" if="desktop" unless="hl" />
	<define name="TRANSLATIONS_ALLOWED" />
	<define name="IRIS_DEBUG" if="debug" />
	
	<!-- Mobile Touch Controls - TEK BİR DEFINE KULLANIN -->
	<define name="TOUCH_CONTROLS" if="mobile" />
	
	<define name="BASE_GAME_FILES" />
	<define name="MULTITHREADED_LOADING" if="cpp" />
	<define name="SHOW_LOADING_SCREEN" />
	<define name="PSYCH_WATERMARKS"/>
	<define name="TITLE_SCREEN_EASTER_EGG"/>
	<define name="VIDEOS_ALLOWED" if="windows || linux || android || mac" unless="32bits"/>
	<define name="CHECK_FOR_UPDATES" if="desktop" unless="debug" />

	<!-- ____________________________ Window Settings ___________________________ -->

	<window width="1280" height="720" fps="60" background="#000000" hardware="true" vsync="false" allow-high-dpi="true" />

	<window if="html5" resizable="true" fullscreen="true" />
	<window if="desktop" orientation="landscape" fullscreen="false" resizable="true" vsync="false"/>
	<window if="mobile" orientation="landscape" fullscreen="true" resizable="false" allow-shaders="true"
		require-shaders="true" allow-high-dpi="true" />
	<window if="switch" orientation="landscape" fullscreen="true" width="0" height="0"
		resizable="true" />

	<!-- _____________________________ Path Settings ____________________________ -->

	<set name="BUILD_DIR" value="export/debug" if="debug" />
	<set name="BUILD_DIR" value="export/release" unless="debug" />
	<set name="BUILD_DIR" value="export/32bit" if="32bits" />

	<classpath name="source" />

	<!-- __________________________ Game Assets & Etc. __________________________ -->

	<!-- OpenAL config -->
	<section if="desktop">
		<assets path="alsoft.txt" rename="plugins/alsoft.ini" type="text" if="windows"/>
		<assets path="alsoft.txt" rename="plugins/alsoft.conf" type="text" unless="windows"/>
	</section>

	<!-- Assets -->
	<assets path="assets/fonts" />
	<assets path="assets/shared" unless="web" />
	<assets path="assets/shared" if="web" embed="true" />
	<assets path="assets/embed" embed="true"/>
	<assets path="assets/videos" if="VIDEOS_ALLOWED" embed="false"/>
	<assets path="assets/songs" unless="web"/>
	<assets path="assets/songs" if="web" embed="true"/>
	<assets path="assets/week_assets" rename="assets" />

	<section if="TITLE_SCREEN_EASTER_EGG">
		<assets path="assets/secrets" rename="assets/shared" unless="web"/>
		<assets path="assets/secrets" rename="assets/shared" if="web" embed="true"/>
	</section>

	<section if="TRANSLATIONS_ALLOWED">
		<assets path="assets/translations" rename="assets" unless="web"/>
		<assets path="assets/translations" rename="assets" if="web" embed="true"/>
	</section>

	<section if="BASE_GAME_FILES">
		<assets path="assets/base_game" rename="assets" unless="web"/>
		<assets path="assets/base_game" rename="assets" if="web" embed="true"/>
	</section>
	
	<section if="MODS_ALLOWED">
		<assets path='example_mods' rename='mods' embed='false' />
	</section>
	<assets path='art/readme.txt' rename='do NOT readme.txt' unless="mobile" />
	
	<!-- || Mobile Assets || -->
	<section if="TOUCH_CONTROLS">
		<assets path="assets/mobile" rename="assets/shared/mobile" embed="true" />
		<assets path="mobile/assets" rename="assets/mobile" embed="true" />
	</section>

	<!-- _______________________________ Libraries ______________________________ -->

	<!-- Core Libraries -->
	<haxelib name="flixel" version="5.6.1"/>
	<haxelib name="flixel-addons" version="3.2.2"/>
	<haxelib name="flixel-ui" />
	<haxelib name="flixel-tools" />
	<haxelib name="tjson" version="1.4.0"/>
	<haxelib name="hxcpp" version="4.3.2" />

	<!-- Psych Engine Core -->
	<haxelib name="linc_luajit" if="LUA_ALLOWED"/>
	<haxelib name="hscript-iris" if="HSCRIPT_ALLOWED" version="1.1.3"/>
	<haxelib name="flxanimate"/>

	<!-- Video Support -->
	<section if="VIDEOS_ALLOWED">
		<haxelib name="hxvlc" if="windows || android || mac" version="2.0.1"/>
		<haxelib name="hxCodec" if="linux" version="3.0.2"/>
	</section>

	<!-- Discord -->
	<haxelib name="hxdiscord_rpc" version="1.2.4" if="DISCORD_ALLOWED"/>

	<!-- Base Game Audio -->
	<section if="BASE_GAME_FILES">
		<haxelib name="grig.audio" />
		<haxelib name="funkin.vis" />
	</section>

	<!-- ========== ANDROID / MOBILE EXTENSIONS ========== -->
	<section if="android">
		<!-- haxelib name="extension-androidtools" -->
		<android installLocation="auto" target-sdk-version="33" />
		<config android:windowSoftInputMode="stateAlwaysHidden" />
		<haxedef name="android_full_screen" />
		<haxedef name="android_skip_setup_focus" />
		
		<!-- Android Permissions -->
		<config:android permission="android.permission.WAKE_LOCK"/>
		<config:android permission="android.permission.INTERNET" />
		<config:android permission="android.permission.VIBRATE" />
		<config:android permission="android.permission.ACCESS_NETWORK_STATE" />
		<config:android permission="android.permission.ACCESS_WIFI_STATE"/>
		<config:android permission="android.permission.WRITE_EXTERNAL_STORAGE" />
		<config:android permission="android.permission.READ_EXTERNAL_STORAGE" />
		<config:android permission="android.permission.READ_MEDIA_IMAGES"/>
		<config:android permission="android.permission.READ_MEDIA_AUDIO"/>
		<config:android permission="android.permission.READ_MEDIA_VIDEO"/>
		<config:android permission="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"/>
		<config:android permission="android.permission.ACCESS_MEDIA_LOCATION"/>
		
		<!-- Android SDK Versions -->
		<android target-sdk-version="36" />
		<android min-sdk-version="24" />
	</section>
	
	<!-- Mobile Controls Library -->
	<section if="mobile">
		<haxelib name="mobile-controls"/>
		<haxedef name="mobile_controls_file_support"/>
	</section>
	
	<haxedef name="mobile_controls_allow_mouse_clicks" if="desktop"/>
	<haxedef name="SHARE_MOBILE_FILES" if="mobile" />
	<haxedef name="lime_disable_motion_sensors" /> <haxedef name="DISABLE_AUDIO_FOCUS" />

	<!-- Debug -->
	<haxelib name="hxcpp-debug-server" if="debug"/>

	<!-- ______________________________ Haxedefines _____________________________ -->
	
	<!-- Lime Fix -->
	<haxedef name="lime_use_old_deltatime" />
	<haxedef name="lime_disable_motion_sensors" if="mobile"/>

	<!-- Discord -->
	<haxedef name="DISCORD_DISABLE_IO_THREAD" if="hxdiscord_rpc" />
	
	<!-- Linux -->
	<haxedef name="NO_PRECOMPILED_HEADERS" if="linux" />

	<!-- Video -->
	<haxedef name="HXC_LIBVLC_LOGGING" if="VIDEOS_ALLOWED debug" />
	<haxedef name="HXVLC_NO_SHARE_DIRECTORY" if="VIDEOS_ALLOWED" />
	<haxedef name="HXVLC_VERBOSE" value="2" if="VIDEOS_ALLOWED debug" />

	<!-- Flixel -->
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />
	<haxedef name="FLX_NO_DEBUG" unless="debug" />

	<!-- Performance -->
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />
	
	<!-- Crash Handler -->
	<define name="CRASH_HANDLER" if="desktop || mobile" />
	
	<section if="cpp">
		<haxedef name="HXCPP_CHECK_POINTER" />
		<haxedef name="HXCPP_STACK_LINE" />
		<haxedef name="HXCPP_STACK_TRACE" />
		<haxedef name="HXCPP_CATCH_SEGV" />
	</section>
	
	<!-- Other -->
	<haxedef name='no-deprecation-warnings' />
	<haxedef name='lime_disable_assets_version' />
	<haxedef name="message.reporting" value="pretty" />
	<haxedef name="hscriptPos" if="HSCRIPT_ALLOWED" />
	
	<!--Avoid memory leaks with for loops in HScript-->
	<haxedef name="loop_unroll_max_cost" value="25" />
	<haxedef name="DISABLED_MACRO_SUPERLATIVE" if="android" />

	<!-- Macros -->
	<haxeflag name="--macro" value="allowPackage('flash')" />
	<!-- include('my.pack') KALDIRILDI - geçersiz placeholder -->

	<!-- Build Type -->
	<define name="x86_BUILD" if="32bits" />

	<!-- _________________________________ Icons _______________________________ -->

	<!-- Desktop Icons -->
	<section unless="mobile">
		<assets path='art/icons/iconOG.png' rename='icon.png' if="linux || mac" />
		<icon path="art/icons/icon16.png" size='16'/>
		<icon path="art/icons/icon32.png" size='32'/>
		<icon path="art/icons/icon64.png" size='64'/>
		<icon path="art/icons/iconOG.png" />
	</section>
	
	<!-- Mobile Icons -->
	<section if="mobile">
		<icon path="art/icons/iconOG.png" />
	</section>

</project>